txt | text/plain | text/plain; charset=us-ascii | ASCII text
json | application/json | application/json; charset=us-ascii | JSON text data
csv | text/plain | text/plain; charset=us-ascii | ASCII text
php | text/x-php | text/x-php; charset=us-ascii | PHP script, ASCII text
html | text/html | text/html; charset=us-ascii | HTML document, ASCII text
xml | text/xml | text/xml; charset=us-ascii | XML 1.0 document, ASCII text
png | image/png | image/png; charset=binary | PNG image data, 1 x 1, 8-bit/color RGBA, non-interlaced
gif | image/gif | image/gif; charset=binary | GIF image data, version 89a, 1 x 1
pdf | application/pdf | application/pdf; charset=iso-8859-1 | PDF document, version 1.4
gz | application/gzip | application/gzip; charset=binary | gzip compressed data
utf8 | text/plain | text/plain; charset=utf-8 | Unicode text, UTF-8 text
empty | application/x-empty | application/x-empty; charset=binary | empty
bin | application/octet-stream | application/octet-stream; charset=binary | data
sh | text/x-shellscript | text/x-shellscript; charset=us-ascii | POSIX shell script, ASCII text executable
svg | image/svg+xml | image/svg+xml; charset=us-ascii | SVG Scalable Vector Graphics image, ASCII text
webp | image/webp | image/webp; charset=binary | RIFF (little-endian) data, Web/P image
nolf | text/plain | text/plain; charset=us-ascii | ASCII text, with no line terminators
crlf | text/plain | text/plain; charset=us-ascii | ASCII text, with CRLF line terminators
latin1 | text/plain | text/plain; charset=iso-8859-1 | ISO-8859 text
image/png image/png png
